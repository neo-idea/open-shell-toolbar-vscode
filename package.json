{
  "name": "open-shell-toolbar",
  "displayName": "Open Shell Toolbar",
  "description": "Pin your frequently-used shell commands as status bar buttons (or a quick-pick popup) and run them in the integrated terminal with one click.",
  "version": "0.2.0",
  "publisher": "neo-idea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neo-idea/open-shell-toolbar-vscode"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Terminal"
  ],
  "category": "Open Shell",
  "keywords": [
    "shell",
    "terminal",
    "toolbar",
    "statusbar",
    "commands",
    "scripts"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "openShell.gettingStarted",
        "title": "Open Shell Toolbar — Get Started",
        "description": "Pin your shell commands to the status bar and run them with one click.",
        "steps": [
          {
            "id": "add",
            "title": "Add your first command",
            "description": "Create a command like `pnpm dev`. Give it a title, an emoji or codicon icon, and pick whether it runs in the integrated terminal. [Add Shell Command](command:openShell.addCommand)",
            "media": { "markdown": "media/walkthrough/add.md" },
            "completionEvents": ["onCommand:openShell.addCommand"]
          },
          {
            "id": "run",
            "title": "Run it from the status bar",
            "description": "Every enabled command becomes a button on the status bar (bottom left). Hover to preview the command, click to run it in the integrated terminal. You can also run one from the palette: [Run Command...](command:openShell.pickAndRun)",
            "media": { "markdown": "media/walkthrough/run.md" },
            "completionEvents": ["onCommand:openShell.runCommand", "onCommand:openShell.pickAndRun"]
          },
          {
            "id": "manage",
            "title": "Manage commands in the sidebar",
            "description": "The Open Shell Toolbar icon in the Activity Bar (left) lists all commands — click to run, right-click to edit, duplicate, disable or delete. Toggle between one-button-per-command (flat) and a single popup button: [Set Display Mode](command:openShell.setDisplayMode)",
            "media": { "markdown": "media/walkthrough/manage.md" },
            "completionEvents": ["onCommand:openShell.setDisplayMode"]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "openShell.addCommand",
        "title": "Add Command",
        "icon": "$(add)"
      },
      {
        "command": "openShell.editCommand",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "openShell.duplicateCommand",
        "title": "Duplicate",
        "icon": "$(copy)"
      },
      {
        "command": "openShell.deleteCommand",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "openShell.toggleEnabled",
        "title": "Enable / Disable",
        "icon": "$(eye)"
      },
      {
        "command": "openShell.runCommand",
        "title": "Run",
        "icon": "$(play)"
      },
      {
        "command": "openShell.pickAndRun",
        "title": "Run Command...",
        "icon": "$(terminal)"
      },
      {
        "command": "openShell.setDisplayMode",
        "title": "Set Display Mode (Flat / Popup)"
      },
      {
        "command": "openShell.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "openShell.importConfig",
        "title": "Import Commands from JSON"
      },
      {
        "command": "openShell.exportConfig",
        "title": "Export Commands to JSON"
      }
    ],
    "viewContainers": {
      "activitybar": [
        {
          "id": "openShellToolbar",
          "title": "Open Shell Toolbar",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "openShellToolbar": [
        {
          "id": "openShellCommands",
          "name": "Shell Commands",
          "contextualTitle": "Open Shell Toolbar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openShellCommands",
        "contents": "No shell commands yet.\n[Add Command](command:openShell.addCommand)\nOr import from JSON: [Import](command:openShell.importConfig)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openShell.addCommand",
          "when": "view == openShellCommands",
          "group": "navigation@1"
        },
        {
          "command": "openShell.refreshTree",
          "when": "view == openShellCommands",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "openShell.runCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "inline@1"
        },
        {
          "command": "openShell.editCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@1"
        },
        {
          "command": "openShell.duplicateCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@2"
        },
        {
          "command": "openShell.toggleEnabled",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@3"
        },
        {
          "command": "openShell.deleteCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "2_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.4.5"
  }
}
