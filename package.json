{
  "name": "open-shell-toolbar",
  "displayName": "Open Shell Toolbar",
  "description": "Pin your frequently-used shell commands as status bar buttons (or a quick-pick popup) and run them in the integrated terminal with one click.",
  "version": "0.1.0",
  "publisher": "neo-idea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neo-idea/open-shell-toolbar-vscode"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Terminal"
  ],
  "keywords": [
    "shell",
    "terminal",
    "toolbar",
    "statusbar",
    "commands",
    "scripts"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openShell.addCommand",
        "title": "Add Shell Command",
        "icon": "$(add)"
      },
      {
        "command": "openShell.editCommand",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "openShell.duplicateCommand",
        "title": "Duplicate",
        "icon": "$(copy)"
      },
      {
        "command": "openShell.deleteCommand",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "openShell.toggleEnabled",
        "title": "Enable / Disable",
        "icon": "$(eye)"
      },
      {
        "command": "openShell.runCommand",
        "title": "Run",
        "icon": "$(play)"
      },
      {
        "command": "openShell.pickAndRun",
        "title": "Open Shell: Run Command...",
        "icon": "$(terminal)"
      },
      {
        "command": "openShell.setDisplayMode",
        "title": "Open Shell: Set Display Mode (Flat / Popup)"
      },
      {
        "command": "openShell.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "openShell.importConfig",
        "title": "Open Shell: Import Commands from JSON"
      },
      {
        "command": "openShell.exportConfig",
        "title": "Open Shell: Export Commands to JSON"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "openShellCommands",
          "name": "Shell Commands",
          "contextualTitle": "Open Shell Toolbar"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openShellCommands",
        "contents": "No shell commands yet.\n[Add Shell Command](command:openShell.addCommand)\nTo learn more, read the [README](https://github.com/neo-idea/open-shell-toolbar-vscode#readme)."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openShell.addCommand",
          "when": "view == openShellCommands",
          "group": "navigation@1"
        },
        {
          "command": "openShell.refreshTree",
          "when": "view == openShellCommands",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "openShell.runCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "inline@1"
        },
        {
          "command": "openShell.editCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@1"
        },
        {
          "command": "openShell.duplicateCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@2"
        },
        {
          "command": "openShell.toggleEnabled",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "1_edit@3"
        },
        {
          "command": "openShell.deleteCommand",
          "when": "view == openShellCommands && viewItem == shellCommand",
          "group": "2_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.4.5"
  }
}
